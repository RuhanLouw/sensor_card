  <diagram id="sensor-controller-flow" name="Sensor Controller Firmware">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Sensor Controller Firmware Flow&#xa;AVR128DB32 | 8x NTC | 2x DS18B20 | 1x K-type | Modbus RTU slave" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="420" y="20" width="760" height="70" as="geometry" />
        </mxCell>

        <mxCell id="startup" value="Power-up / Reset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sysinit" value="SYSTEM_Initialize()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="60" y="230" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pitcb" value="RTC_SetPITIsrCallback(PIT)&#xa;1 Hz uptime + run LED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sys_init" value="_SYS_INIT()&#xa;- clear sys_regs&#xa;- set firmware/status&#xa;- enable sensors&#xa;- MB_Init()&#xa;- KTYPE_Init()&#xa;- DS_Init()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="rs485rx" value="RS485_RX_ENABLE()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="60" y="590" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sei" value="RUN_LED_SET() + sei()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="60" y="680" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="mainloop" value="Main Loop&#xa;while(1)" style="swimlane;html=1;startSize=32;rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="120" width="560" height="660" as="geometry" />
        </mxCell>
        <mxCell id="modbusproc" value="modbus_process()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="mainloop">
          <mxGeometry x="180" y="60" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pollactive" value="STATUS_POLL_ACTIVE?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="mainloop">
          <mxGeometry x="175" y="160" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="measureon" value="MEASURE_LED_SET()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="mainloop">
          <mxGeometry x="180" y="300" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ntcblock" value="Poll enabled NTC1..NTC8&#xa;- select mux A/B/C&#xa;- bit-bang MCP3201&#xa;- average 20 samples&#xa;- convert to temperature" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="mainloop">
          <mxGeometry x="120" y="390" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ktypeready" value="KTYPE state&#xa;READ_READY?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="mainloop">
          <mxGeometry x="175" y="540" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ktyperead" value="Read K-type&#xa;- bit-bang 32 bits&#xa;- decode MAX31855-style frame&#xa;- update temp + CJ + fault" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="mainloop">
          <mxGeometry x="120" y="670" width="320" height="110" as="geometry" />
        </mxCell>

        <mxCell id="dslane" value="DS18B20 Shared State Machine" style="swimlane;html=1;startSize=28;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="950" y="140" width="420" height="330" as="geometry" />
        </mxCell>
        <mxCell id="dsinit" value="DS_Init()&#xa;Start first conversion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="dslane">
          <mxGeometry x="110" y="50" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="dsconv" value="DS_SYSTEM_CONVERTING" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="dslane">
          <mxGeometry x="120" y="140" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="dstimer" value="TCB1 timeout&#xa;DS_Timeout()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="dslane">
          <mxGeometry x="120" y="225" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="dsready" value="DS_SYSTEM_READY" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="dslane">
          <mxGeometry x="120" y="305" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="poll_ds_ready" value="DS system ready?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1030" y="520" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="dsread" value="Read enabled DS sensors&#xa;- reset + skip ROM&#xa;- read scratchpad&#xa;- CRC check&#xa;- keep last valid on error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="970" y="650" width="330" height="110" as="geometry" />
        </mxCell>
        <mxCell id="dsrestart" value="Set DS state = IDLE&#xa;DS_StartConversion()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1010" y="790" width="250" height="80" as="geometry" />
        </mxCell>

        <mxCell id="modbuslane" value="Modbus RTU / RS485" style="swimlane;html=1;startSize=28;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1420" y="140" width="430" height="730" as="geometry" />
        </mxCell>
        <mxCell id="mbinit" value="MB_Init()&#xa;- register UART1 RX/TX callbacks&#xa;- register TCB0 timeout callback&#xa;- start in RX mode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="modbuslane">
          <mxGeometry x="70" y="50" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="rxisr" value="UART1 RX ISR&#xa;Store byte in rx_buffer&#xa;Restart TCB0 frame-gap timer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="modbuslane">
          <mxGeometry x="70" y="180" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="frameready" value="TCB0 timeout&#xa;frame_ready = true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="modbuslane">
          <mxGeometry x="70" y="300" width="290" height="70" as="geometry" />
        </mxCell>
        <mxCell id="framecheck" value="modbus_process()&#xa;address = 2 ?&#xa;CRC valid ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="modbuslane">
          <mxGeometry x="110" y="400" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="fcdecode" value="Function code decode&#xa;0x03 / 0x04 read&#xa;0x10 write multiple" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="modbuslane">
          <mxGeometry x="70" y="540" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="regaccess" value="Read / write sys_regs[]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="modbuslane">
          <mxGeometry x="115" y="660" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="txresp" value="Append CRC&#xa;RS485 TX enable&#xa;send response on UART1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="modbuslane">
          <mxGeometry x="95" y="750" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="txisr" value="UART1 TX complete ISR&#xa;RS485 RX enable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="modbuslane">
          <mxGeometry x="105" y="850" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="reglane" value="Register Update / Published Data" style="swimlane;html=1;startSize=28;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="820" width="980" height="260" as="geometry" />
        </mxCell>
        <mxCell id="updateregs" value="update_sensor_registers()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="reglane">
          <mxGeometry x="400" y="40" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rawregs" value="Write raw sensor data to sys_regs[]&#xa;- NTC1..8&#xa;- NTC error bits&#xa;- K-type temp / CJ / error&#xa;- DS1 / DS2 temp / errors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="reglane">
          <mxGeometry x="80" y="130" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="derivedregs" value="Compute derived values&#xa;- Chamber internal = avg(NTC1..4)&#xa;- Heating element = K-type&#xa;- Evaporator = DS2&#xa;- Superheat = NTC6 - NTC5&#xa;- Subcooling = NTC7 - NTC8&#xa;- External = DS1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="reglane">
          <mxGeometry x="390" y="130" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="masterview" value="Control/master polls sys_regs over Modbus RTU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="reglane">
          <mxGeometry x="760" y="130" width="180" height="100" as="geometry" />
        </mxCell>

        <mxCell id="note" value="Current code notes:&#xa;- DHT11 path exists but is commented out&#xa;- main loop runs without a delay&#xa;- NTC path is synchronous and heavy&#xa;- DS18B20 runs asynchronously with TCB1&#xa;- scaling is mixed: NTC mostly x10, K-type and DS currently x100" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="840" width="240" height="210" as="geometry" />
        </mxCell>

